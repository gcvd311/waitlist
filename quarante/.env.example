# Admin password for /admin and for hosting a game. Required in production.
ADMIN_PASSWORD=change-me

# Supabase (required for real-time multiplayer on Vercel).
# Without these, the app runs on an in-memory store: fine for `npm run dev` on one machine, not for Vercel.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
